# 줄바꿈 통일 — 저장소·작업 사본 모두 LF (Windows·macOS 공통, 기기별 core.autocrlf 설정과 무관)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 — 변환·diff 하지 않음
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
