# ↓ postgres 비밀번호를 YOUR_PASSWORD 자리에 입력하세요 (특수문자는 URL 인코딩: @ → %40, # → %23)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/finlog?schema=public"

AUTH_SECRET="generate-with: npx auth secret"
CRON_SECRET="random-string"

# 선택: 값을 넣으면 소셜 로그인 버튼이 활성화됩니다
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
