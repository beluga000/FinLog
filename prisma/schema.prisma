// FINLOG 데이터 모델 — PROD.MD §3
// 원칙: 금액 = 원 단위 BigInt, 비율 = Decimal, 거래일 = @db.Date, 모든 도메인 테이블은 householdId 소속

// prisma-client: 소스(TS)로 생성 — Node 22가 한글 경로에서 package "imports"(#main-entry-point)를 못 찾는 문제 회피
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Rust 쿼리 엔진 없이 드라이버 어댑터(pg)로 접속 — Vercel 번들에 엔진 바이너리가 빠지는 문제 회피
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 앱 쿼리: Neon pooled(-pooler)
  directUrl = env("DATABASE_URL_UNPOOLED") // 마이그레이션: direct (PgBouncer 경유 시 prepared statement 오류)
}

enum Role {
  OWNER
  MEMBER
}

enum Visibility {
  SHARED
  SUMMARY_ONLY
  PRIVATE
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  INVESTMENT
  PENSION
  REAL_ESTATE
  OTHER_ASSET
  CREDIT_CARD
  LOAN
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
  SAVE_INVEST
  LOAN_REPAY
  ADJUSTMENT
}

enum BudgetBucket {
  NEEDS
  WANTS
  SAVINGS
}

enum RiskProfile {
  STABLE
  STABLE_SEEKING
  NEUTRAL
  ACTIVE
  AGGRESSIVE
}

enum SplitMethod {
  EQUAL
  INCOME_RATIO
  CUSTOM
}

enum PlanSource {
  RECOMMENDED
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum BusinessDayAdjust {
  NONE
  PREV
  NEXT
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  passwordHash      String?
  createdAt         DateTime           @default(now())
  /// 관리자 가입 승인 시각. null = 승인 대기 (로그인 불가). ADMIN_EMAILS 의 이메일은 가입 즉시 승인
  approvedAt        DateTime?
  /// 로그인 세션 세대. "모든 기기에서 로그아웃" 시 +1 → 이전에 발급된 로그인 토큰이 모두 무효
  sessionVersion    Int                @default(0)
  /// 화면 테마: forest(숲) | sea(바다) | dusk(저녁). 사용자별 — 배우자와 따로 고른다
  palette           String             @default("forest")
  /// 총급여 구간 — 연금 세액공제율 계산용 (UNDER = 기준 이하 · OVER = 초과, null = 모름). 기준액은 src/lib/finance/tax-accounts.ts
  salaryBand        String?
  memberships       HouseholdMember[]
  riskAssessments   RiskAssessment[]
  pushSubscriptions PushSubscription[]
}

model Household {
  id                 String                 @id @default(cuid())
  name               String
  monthStartDay      Int                    @default(1)
  emergencyMonths    Int                    @default(3)
  /// 정기 결제 찾기에서 "아니에요" 한 사용처 (`${type}:${merchantKey}`) — 다시 권하지 않는다
  dismissedRecurring String[]               @default([])
  createdAt          DateTime               @default(now())
  members            HouseholdMember[]
  invites            HouseholdInvite[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  recurringRules     RecurringRule[]
  budgets            Budget[]
  splitRules         SplitRule[]
  settlements        Settlement[]
  plans              PortfolioPlan[]
  goals              AssetGoal[]
  lifeEvents         LifeEvent[]
  auditLogs          AuditLog[]
  merchantRules      MerchantCategoryRule[]
  challenges         Challenge[]
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  role        Role
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  code            String    @unique
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String            @id @default(cuid())
  householdId        String
  ownerUserId        String?
  name               String
  type               AccountType
  institution        String?
  defaultVisibility  Visibility        @default(SHARED)
  assetClassTag      String?
  isArchived         Boolean           @default(false)
  /// 카드 결제일 / 대출 납입일 (1~31, 짧은 달은 말일). CREDIT_CARD · LOAN
  billingDay         Int?
  /// 카드 대금 / 대출 이자·상환금이 빠져나가는 계좌. CREDIT_CARD · LOAN
  paymentAccountId   String?
  /// 예적금 가입일 / 대출 실행일. SAVINGS · LOAN
  openedOn           DateTime?         @db.Date
  /// 예적금·대출 만기일. SAVINGS · LOAN
  maturityDate       DateTime?         @db.Date
  /// 예적금·대출 연 금리 (0.035 = 3.5%). SAVINGS · LOAN
  interestRate       Decimal?          @db.Decimal(9, 6)
  /// 정책형 적금 종류 (YOUTH_LEAP 청년도약계좌 · YOUTH_FUTURE 청년미래적금). SAVINGS 만, 일반 상품은 null
  savingsProduct     String?
  /// 정책형 적금의 기여금 구간 (소득 구간·일반/우대형). 값은 src/lib/finance/savings-products.ts
  savingsTier        String?
  /// 대출 상환 방식 (BULLET 만기일시 · EQUAL_PAYMENT 원리금균등 · EQUAL_PRINCIPAL 원금균등). LOAN 만. 계산은 src/lib/finance/loan.ts
  loanRepayment      String?
  /// 전세·월세 보증금 대출 — 보증금으로 묶여 내가 쓰는 돈이 아니므로 순자산·부채 합계에서 뺀다 (이자만 고정비). LOAN 만
  depositLoan        Boolean           @default(false)
  /// 세제 혜택 계좌 (PENSION_SAVINGS 연금저축 · IRP — PENSION 만 / ISA — INVESTMENT · SAVINGS 만). 한도는 src/lib/finance/tax-accounts.ts
  taxWrapper         String?
  /// 잔액을 1년에 한 번만 확인 (전세보증금처럼 거의 안 바뀌는 계좌) — 확인할 일·잔액 맞추기에서 365일 기준
  balanceCheckYearly Boolean           @default(false)
  createdAt          DateTime          @default(now())
  household          Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paymentAccount     Account?          @relation("cardPayment", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paidCards          Account[]         @relation("cardPayment")
  snapshots          AccountSnapshot[]
  outgoing           Transaction[]     @relation("fromAccount")
  incoming           Transaction[]     @relation("toAccount")

  @@index([householdId])
}

model AccountSnapshot {
  id        String   @id @default(cuid())
  accountId String
  asOf      DateTime @db.Date
  balance   BigInt
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, asOf])
}

model Category {
  id            String                 @id @default(cuid())
  householdId   String
  parentId      String?
  name          String
  txType        TxType
  bucket        BudgetBucket?
  icon          String?
  sortOrder     Int                    @default(0)
  household     Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent        Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[]             @relation("CategoryTree")
  transactions  Transaction[]
  merchantRules MerchantCategoryRule[]

  @@index([householdId, txType])
}

model Transaction {
  id              String         @id @default(cuid())
  householdId     String
  createdByUserId String
  paidByUserId    String?
  type            TxType
  date            DateTime       @db.Date
  amount          BigInt
  fromAccountId   String?
  toAccountId     String?
  categoryId      String?
  merchant        String?
  memo            String?
  visibility      Visibility
  isFixed         Boolean        @default(false)
  recurringRuleId String?
  importHash      String?
  settlementId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  needsReview     Boolean        @default(false) // v3 §2-10: 정기 규칙으로 생성된 거래 → 홈 "확인할 일"
  notDuplicate    Boolean        @default(false) // 가계부 "같은 결제일까요?"에 "다른 결제예요" — 다시 의심하지 않는다
  household       Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromAccount     Account?       @relation("fromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account?       @relation("toAccount", fields: [toAccountId], references: [id])
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@unique([householdId, importHash])
  @@unique([recurringRuleId, date])
  @@index([householdId, date])
  @@index([householdId, categoryId, date])
  /// 확인할 일(needsReview) — 확인할 거래가 없을 때도 전체 이력을 훑지 않게
  @@index([householdId, needsReview, date])
  /// 계좌별 흐름 — 계좌 삭제 시 참조 검사, 계좌 단위 조회
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
}

model RecurringRule {
  id                String            @id @default(cuid())
  householdId       String
  createdByUserId   String
  name              String
  template          Json
  dayOfMonth        Int
  businessDayAdjust BusinessDayAdjust @default(NONE)
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date
  lastRunOn         DateTime?         @db.Date
  isActive          Boolean           @default(true)
  household         Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([householdId])
}

model Budget {
  id          String    @id @default(cuid())
  householdId String
  categoryId  String?
  month       String
  amount      BigInt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month])
}

model SplitRule {
  id          String      @id @default(cuid())
  householdId String
  categoryId  String?
  method      SplitMethod
  ratios      Json?
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Settlement {
  id          String    @id @default(cuid())
  householdId String
  month       String
  fromUserId  String
  toUserId    String
  amount      BigInt
  settledAt   DateTime?
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model RiskAssessment {
  id        String      @id @default(cuid())
  userId    String
  answers   Json
  score     Int
  profile   RiskProfile
  takenAt   DateTime    @default(now())
  expiresAt DateTime
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssetClassAssumption {
  id             String   @id
  label          String
  expectedReturn Decimal  @db.Decimal(9, 6)
  volatility     Decimal  @db.Decimal(9, 6)
  effectiveFrom  DateTime @db.Date
}

model PortfolioPlan {
  id             String       @id @default(cuid())
  householdId    String
  name           String
  source         PlanSource
  baseProfile    RiskProfile?
  allocations    Json
  expectedReturn Decimal      @db.Decimal(9, 6)
  volatility     Decimal      @db.Decimal(9, 6)
  createdAt      DateTime     @default(now())
  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goals          AssetGoal[]
}

model AssetGoal {
  id               String         @id @default(cuid())
  householdId      String
  name             String
  targetAmount     BigInt
  targetIsReal     Boolean        @default(true)
  targetDate       DateTime       @db.Date
  priority         Int
  expectedReturn   Decimal        @default(0.05) @db.Decimal(9, 6)
  planId           String?
  linkedAccountIds String[]
  monthlyCommit    BigInt?
  /// 목표를 만들(수정할) 때 기존 잔액 중 이 목표 몫으로 넣은 금액
  startAmount      BigInt         @default(0)
  /// 그때의 기준 잔액(연결 계좌 합계, 없으면 순자산). 모인 돈 = startAmount + (지금 잔액 - baseBalance)
  baseBalance      BigInt         @default(0)
  /// 기준을 잡은 날(목표 생성·이미 모은 돈 수정·연결 계좌 보관/복원). null = 예전 방식(잔액 전체를 모인 돈으로 셈)
  baseSetOn        DateTime?      @db.Date
  /// 홈에서 이미 보고 닫은 진행률 알림 (0·25·50·75·100)
  milestoneSeen    Int            @default(0)
  status           GoalStatus     @default(ACTIVE)
  createdAt        DateTime       @default(now())
  household        Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plan             PortfolioPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([householdId])
}

model LifeEvent {
  id          String    @id @default(cuid())
  householdId String
  kind        String
  startMonth  String
  params      Json
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model TaxRuleSet {
  year  Int  @id
  rules Json
}

model AuditLog {
  id          String    @id @default(cuid())
  householdId String
  userId      String
  action      String
  entity      String
  entityId    String
  diff        Json?
  at          DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, at])
}

/// 시도 횟수 제한 (로그인·가입·초대 코드). 고정 창 카운터 — src/lib/security/rate-limit.ts
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// 가맹점 → 카테고리 규칙 (가구 공유). 기록 창에서 가맹점을 쓰면 이 카테고리를 먼저 채운다.
/// merchantKey = 공백·기호를 뺀 대문자 가맹점 이름 (src/lib/finance/merchant-rules.ts merchantKey)
model MerchantCategoryRule {
  id              String    @id @default(cuid())
  householdId     String
  merchantKey     String
  /// 화면에 보여 줄 가맹점 이름 (마지막으로 고친 사람이 쓴 그대로)
  merchant        String
  categoryId      String
  createdByUserId String
  updatedAt       DateTime  @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, merchantKey])
}

/// 이번 달 챌린지 — 결산 제안 "같은 사용처 N번"을 "이번 달 M번까지"로 (가구 공유, 달마다 하나씩)
model Challenge {
  id              String    @id @default(cuid())
  householdId     String
  /// 챌린지 달 (YYYY-MM, 가구 월 시작일 기준)
  month           String
  merchantKey     String
  merchant        String
  limitCount      Int
  /// 결산 달(시작한 달의 전달) 방문 횟수·금액 — 다음 결산에서 비교
  baselineCount   Int
  baselineAmount  BigInt
  createdByUserId String
  createdAt       DateTime  @default(now())
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, month, merchantKey])
}

/// 푸시 알림 구독 (기기·브라우저마다 하나). 보낼 때 404·410 이 오면 지운다
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
